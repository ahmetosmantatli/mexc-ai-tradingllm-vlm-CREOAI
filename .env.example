# MEXC Hybrid AI Trading — environment template
# Copy to .env and fill locally. NEVER commit real secrets.

# Compose project (keep distinct from Creotora on shared Hetzner VPS)
COMPOSE_PROJECT_NAME=mexc-ai

# Safety gates (defaults are paper-only)
LIVE_TRADING_ENABLED=false
BROKER_MODE=paper

# Default risk profile for new installs
RISK_PROFILE=aggressive_growth

# Account / floor — SEED ONLY (örnek / seed, gerçek kasa değil)
# These values initialize equity on first boot or empty DB / EQUITY_RESET=true.
# Ahmet may deposit 500, 700, or any amount; runtime equity E comes from
# persisted paper broker equity (Postgres) or MEXC read-only available balance.
# Risk engine / position sizing always use current E — never this static example.
STARTING_CAPITAL_TRY=700
CAPITAL_FLOOR_TRY=700
# Set true only to wipe persisted equity and re-seed from the values above.
EQUITY_RESET=false
# Optional display FX when converting MEXC USDT available → TRY equity view.
# USDT_TRY_RATE=34.5
TARGET_EQUITY_TRY=8000
STRETCH_TARGET_EQUITY_TRY=100000
CURRENCY=TRY

# Always-on scan + fee-free preference (Aggressive Growth defaults)
ALWAYS_ON_SCAN=true
FEE_FREE_PREFERENCE=true
CHART_VISION_ENABLED=false
CHART_VISION_CACHE_TTL_SECONDS=300

# API / worker
API_HOST=0.0.0.0
API_PORT=8080
LOG_LEVEL=INFO
WORKER_LOOP_INTERVAL_SECONDS=60
DEFAULT_TARGET_LEVERAGE=10

# Scanner liquidity filters (public market data)
SCANNER_MIN_QUOTE_VOLUME_24H=500000
SCANNER_MAX_SPREAD_BPS=25
SCANNER_MAX_SYMBOLS=40

# Database / Redis (Compose service names)
DATABASE_URL=postgresql+psycopg://mexc:mexc@postgres:5432/mexc_ai
REDIS_URL=redis://redis:6379/0

# Postgres bootstrap (Compose only)
POSTGRES_USER=mexc
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=mexc_ai

# MEXC — use a NEW read-only key for Phase 1. No trade/withdraw permissions.
# Leave blank for paper-only local runs that only use public market-data stubs.
MEXC_API_KEY=
MEXC_API_SECRET=
MEXC_BASE_URL=https://api.mexc.com
MEXC_RECV_WINDOW_MS=5000

# Anthropic — optional. Leave empty for deterministic LangGraph stub/fallback (tests).
# Never commit real keys. Never paste keys into chat or git.
ANTHROPIC_API_KEY=

# Optional free external provider discovery. Existing Groq/Gemini routes remain.
# Run python -m trading.control.external_models setup for hidden key input.
EXTERNAL_MODELS_ENABLED=false
EXTERNAL_MODELS_FILE=data/external-models.json
OPENROUTER_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Confirm only for Workers Free. Paid plans can bill beyond the free allocation.
CLOUDFLARE_FREE_PLAN_CONFIRMED=false
# Shared account/day local neuron guard, not provider billing or remaining quota.
CLOUDFLARE_DAILY_NEURON_BUDGET=9000
EXTERNAL_MAX_COMPLETION_TOKENS=2048
# Shared LIVE/PAPER activity summaries, no extra model request. State changes
# are rate-limited separately; a dead process needs an external watchdog.
TELEGRAM_ACTIVITY_INTERVAL_SECONDS=900

# Optional: override residual / risk hard caps (Risk Engine still enforces SL + wipe ban)
# RISK_PER_TRADE_PCT=0.03
# ABS_MAX_LOSS_PCT=0.05
# RESIDUAL_MIN_PCT=0.40

# Persistent paper worker (USDT only); legacy TRY seeds above are ignored by worker.
RUNTIME_DB_PATH=data/runtime.sqlite3
REQUIRE_MEXC_BALANCE=true
PAPER_SEED_USDT=0
POSITION_POLL_SECONDS=5
PAPER_MAX_LEVERAGE=3
RISK_PER_TRADE_PCT=0.01
DAILY_LOSS_LIMIT_PCT=0.02
DRAWDOWN_LIMIT_PCT=0.08
PAPER_FEE_RATE=0.0006
PAPER_SLIPPAGE_BPS=5
LIQUIDATION_BUFFER_PCT=0.02
KILL_SWITCH_PATH=data/STOP
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_DAILY_BUDGET_USD=3
ANTHROPIC_TOTAL_BUDGET_USD=24
ANTHROPIC_INPUT_USD_PER_MILLION=3
ANTHROPIC_OUTPUT_USD_PER_MILLION=15
ANTHROPIC_MIN_INTERVAL_SECONDS=300
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_STATUS_INTERVAL_SECONDS=3600

# Multi-account Telegram control; create registry from accounts.example.json.
ACCOUNTS_FILE=secrets/accounts.json
SHARED_BUDGET_DB_PATH=data/shared-budget.sqlite3
ANALYSIS_VERSION=text
AHMET_MEXC_KEY=
AHMET_MEXC_SECRET=
FRIEND_MEXC_KEY=
FRIEND_MEXC_SECRET=

# Optional local spend cap; false still tracks estimated usage and notifies on AI errors.
AI_BUDGET_ENABLED=false
POSITION_UPDATE_SECONDS=60
# Generate once on server; keep stable, secret and backed up. Never commit.
ACCOUNT_VAULT_KEY=

# Groq-first for both variants; vision must support all three chart images.
GROQ_API_KEY=
AI_PRIMARY_PROVIDER=groq
GROQ_TEXT_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# true authorizes potentially paid Claude fallback; false waits on Groq failure.
AI_CLAUDE_FALLBACK_ENABLED=true
# Conservative estimated per-minute Groq request+output token allowance.
# Match your Groq account/model limits; 0 disables the local quota estimate.
GROQ_REQUEST_TOKEN_BUDGET=8000
GROQ_MAX_COMPLETION_TOKENS=2048
AI_PROVIDER_TIMEOUT_SECONDS=25

# Additional free-quota provider. Billing/free access depends on your Google project.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_COMPLETION_TOKENS=2048
# Empty inherits AI_PRIMARY_PROVIDER. Set gemini to prefer it for charts.
AI_VISION_PRIMARY_PROVIDER=

# Queue scans independently of the AI minimum interval.
CANDIDATE_TTL_SECONDS=900
CANDIDATE_QUEUE_LIMIT=80
ANTHROPIC_DECISION_MAX_TOKENS=1200

# Optional multi-credential quota pool. Secondary keys remain server-only.
AI_PROVIDER_POOL_ENABLED=false
AI_PARALLEL_CANDIDATES=2
# quota removes the fixed analysis interval; interval retains the setting above.
AI_SCHEDULE_MODE=interval
AI_POOL_RETRY_SECONDS=5
AI_POOL_MAX_RETRY_ATTEMPTS=1
AI_POOL_MAX_GENERATION_REQUESTS=3
GROQ_API_KEY_2=
GEMINI_API_KEY_2=
# Same identity = shared quota, regardless of key count. Only declare distinct
# groups after verifying independent organization/project quotas in the console.
GROQ_QUOTA_GROUP=groq-main
GROQ_QUOTA_GROUP_2=groq-main
GEMINI_QUOTA_GROUP=gemini-main
GEMINI_QUOTA_GROUP_2=gemini-main
GROQ_RPM=30
GROQ_TPM=8000
GROQ_RPD=1000
GROQ_TPD=200000
GEMINI_RPM=15
GEMINI_TPM=250000
GEMINI_RPD=500
GEMINI_TPD=0

# Optional PAPER research objective; reporting only, never overrides risk limits.
# Target is initial session USDT * multiple, not a TRY conversion or promise.
RESEARCH_GOAL_ENABLED=false
RESEARCH_GOAL_MULTIPLE=14
RESEARCH_GOAL_DAYS=7
RESEARCH_GOAL_STRETCH_MULTIPLE=200

# LIVE is OFF by default. PAPER settings above remain the normal setup.
# LiveFleet requires every gate plus a fresh authorized Telegram Start.
LIVE_AUTOMATIC_ENABLED=false
# Opt-in IOC pilot with one native SL/TP pair. Existing accounts select it in Telegram.
LIVE_RUNNER2_ENABLED=false
LIVE_RUNNER3_ENABLED=false
# Optional reporting objective only.
# LIVE_RUNNER3_DAILY_NET_TARGET_USDT=1
LIVE_ALLOWED_ACCOUNTS=[]
LIVE_READINESS_ACK=
LIVE_MAX_LEVERAGE=10
LIVE_MAX_POSITIONS=4
# Optional. Only applies to the LIVE Aggressive profile. Unset uses 5.5%.
# Weekly loss and drawdown gates are evaluated independently.
# Optional daily threshold up to 50%. Peak drawdown may halt entries earlier.
# LIVE_AGGRESSIVE_DAILY_LOSS_LIMIT_PCT=0.50
LIVE_AGGRESSIVE_WEEKLY_LOSS_LIMIT_ENABLED=true

# profile retains the fixed local/profile leverage caps.
# exchange uses the fresh per-symbol/per-side public+private limit, requires an
# explicit model sizing plan, and retains loss/margin/stop-liquidation checks.
LIVE_LEVERAGE_MODE=profile

# Optional LIVE model market-entry/SL/TP planning grounded in supplied closed candles.
# False keeps quant levels; true permits a validated model plan or quant fallback.
LIVE_PRICE_PLAN_ENABLED=false

# Optional event-driven AI management of owned LIVE positions. No PAPER changes.
# Tighten stop / partial exit / close; keep native target and initial risk immutable.
LIVE_POSITION_MANAGEMENT_ENABLED=false
# Minimum time between management reviews per position; unchanged events are skipped.
LIVE_MANAGEMENT_MIN_INTERVAL_SECONDS=60

# LIVE: size each entry-analysis batch from currently available local quota groups.
# AI_PARALLEL_CANDIDATES remains the hard worker ceiling (1..8), not a request target.
AI_DYNAMIC_PARALLEL_ENABLED=true
